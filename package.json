{
  "name": "xueban-local-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-assets.mjs && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "check": "pnpm test && pnpm build && pnpm test:browser"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "docx": "9.8.1",
    "fflate": "0.8.3",
    "katex": "0.19.0",
    "markdown-it": "15.0.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "8.3.2"
  }
}
